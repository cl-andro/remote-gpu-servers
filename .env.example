# ---------------------------------------------------------------------------
# .env.example — copy this to .env and fill in your own token.
#
#   cp .env.example .env
#
# .env is git-ignored. NEVER commit your real token.
# ---------------------------------------------------------------------------

# Kaggle API token (starts with "KGAT_...").
# Get it from: https://www.kaggle.com/settings  ->  API  ->  "Create New Token"
# The first line of the downloaded kaggle.json / the token shown there.
KAGGLE_API_TOKEN=KGAT_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the default client endpoint instead of using url.txt
# SALUKI_URL=https://your-tunnel.trycloudflare.com

# Optional: per-request timeout in seconds for saluki.py (default 600)
# SALUKI_TIMEOUT=600