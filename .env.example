# ---------------------------------------------------------------------------
# .env.example — copy this to .env and fill in your own tokens.
#
#   cp .env.example .env
#
# .env is git-ignored. NEVER commit your real tokens.
# ---------------------------------------------------------------------------

# 1. Kaggle API Token (KGAT_...)
# Get it from: https://www.kaggle.com/settings -> API -> "Create New Token"
KAGGLE_API_TOKEN=KGAT_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. Cloudflare Tunnel Token (optional, for custom domain e.g. ai.xxxxx.xyz)
# If left empty, a free random *.trycloudflare.com quick tunnel is used.
CLOUDFLARE_TUNNEL_TOKEN=

# 3. Permanent Domain URL (optional, e.g. https://ai.xxxxx.xyz)
CLUSTER_URL=

# 4. Web UI & API Authentication (HTTP Basic Auth)
# When set, any browser or client visiting the server must supply these credentials.
CLUSTER_AUTH_USER=admin
CLUSTER_AUTH_PASS=changeme1234

# 5. Optional API Key for programmatic / CLI access
CLUSTER_API_KEY=

# 6. Request Timeout (in seconds, default 600)
CLUSTER_TIMEOUT=600